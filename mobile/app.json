{
  "expo": {
    "name": "Solace AI",
    "slug": "solace-ai",
    "scheme": "solace",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "ai.solace.app"
    },
    "ios": {
      "bundleIdentifier": "ai.solace.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      "expo-notifications",
      "expo-web-browser",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
