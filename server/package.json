{
  "name": "@solace/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/server/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@solace/contracts": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "google-auth-library": "^10.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pino": "^9.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
